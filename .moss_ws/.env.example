# MOSS 的环境变量配置.
# 默认的环境变量记录在这里.
# 需要将 .env.example 复制到 .env 或者当前用户运行时.
# (可以使用 `moss workspace copy-env` 但不用也行. 将环境变量配置到 workspace 里, 存在被 AI 模型读取文件看到的可能性).
# 这里列出系统预设的环境变量配置.


# --- 自带 speech 模块使用火山引擎的双工语音理解大模型驱动 --- #
VOLCENGINE_STREAM_TTS_APP="火山引擎双工语音理解大模型 app id"
VOLCENGINE_STREAM_TTS_ACCESS_TOKEN="火山引擎双工语音理解大模型 access token"
VOLCENGINE_STREAM_TTS_API_KEY="火山引擎新版控制台 API Key（可选，与旧版鉴权兼容共存）"

# --- MiMo TTS --- #
MIMO_API_KEY="小米 MiMo API key"

# --- 基础模型配置, 用 anthropic 作为默认 --- #
# deepseek / seed / qwen / 小米 ... 皆可, model 优先支持多模态.
ANTHROPIC_BASE_URL="anthropic api 的 base url"
ANTHROPIC_API_KEY="anthropic api 的 api key"
ANTHROPIC_MODEL="model name"
ANTHROPIC_SMALL_FAST_MODEL="model name"

# --- Unitree G1 人形机器人 --- #
# unitree_sdk2_python 的本地 clone 路径。PC2 上 clone 到 g1 app 的 src/ 目录下。
# 模式 unitree_g1 启动时必填，无默认值。
UNITREE_G1_SDK_PATH=""

# --- 第三方 MCP server API key --- #
# 通过 $ENV_VAR 语法在 add_server 时引用，避免在 CTML 中暴露。
# 示例：BAIDU_MAPS_API_KEY="从百度地图开放平台获取"
