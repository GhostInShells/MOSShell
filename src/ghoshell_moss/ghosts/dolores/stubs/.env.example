# Dolores ghost 启动期环境变量 — 复制为 .env 后生效 (每次启动 load, 外层环境优先).
# 未来所有启动期配置项都放这里; 缺省即"不写该行"时的行为.

# dsh web 是否自动打开浏览器 (true 则不自动打开). 默认 false = 启动即开.
DSH_WEB_NO_OPEN=false

# dsh 默认推理模型 — 每次启动压进 .dsh/settings.yaml 的 agent-default-model, 是模型的权威.
# 必须是有视觉的 id (deepseek-flash / deepseek-v4-flash-vision-exp): 纯文本 id 会让 dsh
# 在出站前把每张图换成文本占位, ghost 就"看不见"图了.
DOLORES_DEFAULT_MODEL=deepseek-flash
DOLORES_DEFAULT_MODEL_PROVIDER=deepseek-official
