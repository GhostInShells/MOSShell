# Dolores ghost 启动期环境变量 — 复制为 .env 后生效 (每次启动 load, 外层环境优先).
# 未来所有启动期配置项都放这里; 缺省即"不写该行"时的行为.

# dsh web 是否自动打开浏览器 (true 则不自动打开). 默认 false = 启动即开.
DSH_WEB_NO_OPEN=false

# dsh 可执行路径 — 钉某个 ghost 到特定 dsh 安装 (如本地某个版本) 时取消注释, 写绝对路径.
# 省略 → PATH 上的 dsh. 相对路径按 dsh 进程 cwd 解析, 容易踩坑, 建议只写绝对路径.
# DSH_BINARY=/path/to/dsh

# dsh 默认推理模型由 Ghost 声明 (DoloresMeta.default_model) 在首次启动 seed-once 写进
# .dsh/settings.yaml 的 agent-default-model 段; 此后段归 ghost home 所有, dsh web Models
# 面可改.
