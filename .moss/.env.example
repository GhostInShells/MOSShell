# MOSS environment variables.
# Default environment variables are recorded here.
# Does not override globals.
# Copy .env.example to .env or the current user's runtime.
# System-preset environment variables are listed here.

# --- Bundled voice (ASR + TTS), driven by Volcengine --- #
# Obtain these in the Volcengine console. Unset, ASR/TTS keep their "$VAR"
# placeholder and cannot authenticate, so voice input/output stay non-functional.

# ASR — seed bigmodel streaming recognition
SEED_API_KEY="Volcengine console API key (X-Api-Key)"

# TTS — bidirectional streaming synthesis
VOLCENGINE_STREAM_TTS_APP="Volcengine app id"
VOLCENGINE_STREAM_TTS_ACCESS_TOKEN="Volcengine access token"
VOLCENGINE_STREAM_TTS_API_KEY="Volcengine console API key"

# --- Audio devices (optional) --- #
# Device name substring for capture (input) / player (output). Empty = miniaudio
# default discovery. Set to a substring of your device name, e.g.:
#   MOSS_AUDIO_CAPTURE_DEVICE="MacBook"   # microphone
#   MOSS_AUDIO_PLAYER_DEVICE="OpenRun"    # bluetooth headset
MOSS_AUDIO_CAPTURE_DEVICE=""
MOSS_AUDIO_PLAYER_DEVICE=""

# --- LLM providers (anthropic as default) --- #
# deepseek / seed / qwen / xiaomi ... all work; prefer multimodal models.

ANTHROPIC_BASE_URL="anthropic api base url"
ANTHROPIC_API_KEY="anthropic api key"
ANTHROPIC_MODEL="model name"
ANTHROPIC_SMALL_FAST_MODEL="model name"

DEEPSEEK_API_KEY="deepseek api key"
DEEPSEEK_ANTHROPIC_BASE_URL="deepseek anthropic-protocol base url"
DEEPSEEK_OPENAI_BASE_URL="deepseek openai-protocol base url"
