# Desktop GUI — environment configuration
# Copy to .env and edit. .env is gitignored.

# Ports — change these if another skin already uses the defaults
REFLEX_FRONTEND_PORT=3000
REFLEX_BACKEND_PORT=8000

# Bun — set to "yes" to use system bun (skip Reflex auto-download)
REFLEX_USE_SYSTEM_BUN=no

# Backend-only mode — set to "yes" for headless/production
REFLEX_BACKEND_ONLY=no
