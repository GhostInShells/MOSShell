# Camera vision node — cell-level config (copy to .env to override defaults).
# Loaded at startup via load_dotenv. The ghost can still re-configure at
# runtime via the set_config command (within safe bounds).
#
# Copy:  cp .env.example .env

# Camera device (see <camera:list_cameras />)
CAMERA_INDEX=0

# Resolution (safe bounds: 640x480 / 1280x720 / 1920x1080)
CAMERA_WIDTH=640
CAMERA_HEIGHT=480

# Background capture rate when watch is on (safe bounds: 0.5..30)
CAMERA_FPS=2.0

# Start with watch on (camera opens + captures immediately). true/false.
WATCH_ON_START=true

# MJPEG viewer
VIEWER_HOST=127.0.0.1
VIEWER_PORT=8765
