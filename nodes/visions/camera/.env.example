# Camera vision node — cell-level config (copy to .env to override defaults).
# Loaded at startup via dotenv. Launch arguments `--camera N` / `--port N`
# override CAMERA_INDEX / VIEWER_PORT respectively.

# Device identity (also overridable via `--camera N`).
CAMERA_INDEX=0

# Resolution (safe bounds: 640x480 / 1280x720 / 1920x1080).
CAMERA_WIDTH=640
CAMERA_HEIGHT=480

# Capture rate. This drives the live human stream; the per-round context image
# is decimated independently of it.
CAMERA_FPS=10.0

# Local MJPEG viewer (port also overridable via `--port N`).
VIEWER_HOST=127.0.0.1
VIEWER_PORT=8765

# Policy gate — set to 0 / false / no / off to refuse launch (probe fails).
CAMERA_ALLOW=1
