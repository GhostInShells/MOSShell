# Push node — cell-level config (copy to .env to override defaults).
# Loaded at startup via dotenv. `--port N` overrides MOSS_PUSH_PORT.

# Escape hatches, not requirements: a request carries the capture index it wants,
# and these only pin the default for THIS machine when its display does not sit at
# the stock index. Leave them out on a stock Mac (camera 0, main display 1).
# Enumerate the real devices:
#   ffmpeg -hide_banner -f avfoundation -list_devices true -i ""
PUSH_SCREEN_INDEX=1
PUSH_CAMERA_INDEX=0

# Policy gate — set to 0 / false / no / off to refuse launch (probe fails).
PUSH_ALLOW=1
