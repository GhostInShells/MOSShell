# Push node — cell-level config (copy to .env to override defaults).
# Loaded at startup via dotenv. `--port N` overrides MOSS_PUSH_PORT.

# avfoundation capture indices (macOS). Defaults match a stock Mac: index 0 is
# the built-in camera, index 1 is the main display. Enumerate the real devices:
#   ffmpeg -hide_banner -f avfoundation -list_devices true -i ""
PUSH_SCREEN_INDEX=1
PUSH_CAMERA_INDEX=0

# Policy gate — set to 0 / false / no / off to refuse launch (probe fails).
PUSH_ALLOW=1
