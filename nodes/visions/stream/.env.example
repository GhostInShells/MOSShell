# Stream vision node — behavior knobs (copy to .env). Identity (--address) is
# a launch argument, not env.

# Policy gate: set to 0/false/no/off to refuse launch.
STREAM_ALLOW=1

# How often the tail frame refreshes (ffmpeg output fps).
STREAM_FPS=2

# Model-bound sampling: a frame over these is resampled once at emission.
STREAM_MAX_EDGE=1568
STREAM_MAX_BYTES=524288
STREAM_JPEG_QUALITY=80

# A frame older than this is "stale" — the channel health short-circuits.
STREAM_STALE_SECONDS=5

# Optional label (identity read-back); overrides the raw address in model text.
STREAM_LABEL=

# Optional static address; prefer passing --address at launch instead.
# STREAM_ADDRESS=rtmp://127.0.0.1/live/desk
