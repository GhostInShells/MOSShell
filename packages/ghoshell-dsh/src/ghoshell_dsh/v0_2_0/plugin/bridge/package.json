{
  "name": "@local/ghoshell-dsh-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["sidebarRight", "layout", "slots", "sessions", "shortcuts", "remote"]
    }
  }
}
